{
  "info": {
    "name": "ChatApp",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "Create",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/chatapp/chatrooms",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"roomName\": \"general\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.to.have.status(201);"
            ]
          }
        }
      ]
    },
    {
      "name": "Join",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/chatapp/chatrooms/general/join",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"participant\": \"guest_user\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.to.have.status(200);"
            ]
          }
        }
      ]
    },
    {
      "name": "Send",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/chatapp/chatrooms/general/messages",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"participant\": \"guest_user\", \"message\": \"Hello, everyone!\"}"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.to.have.status(200);"
            ]
          }
        }
      ]
    },
    {
      "name": "History",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/chatapp/chatrooms/general/messages?limit=10"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.to.have.status(200);"
            ]
          }
        }
      ]
    },
    {
      "name": "Delete",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/chatapp/chatrooms/general"
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.response.to.have.status(200);"
            ]
          }
        }
      ]
    }
  ]
}